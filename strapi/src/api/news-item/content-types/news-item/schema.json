{
  "kind": "collectionType",
  "collectionName": "news_items",
  "info": {
    "singularName": "news-item",
    "pluralName": "news-items",
    "displayName": "خبر",
    "description": "الأخبار والبيانات الرسمية (صفحة الأخبار)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "unique": true,
      "regex": "^[a-z0-9-]+$"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "statement",
        "meeting",
        "project",
        "general"
      ],
      "default": "general"
    },
    "body": {
      "type": "blocks"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "legacyId": {
      "type": "integer",
      "unique": true
    }
  }
}