{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "مقال",
    "description": "مقالات مدونة الشباب (آراء كتّابها)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "unique": true,
      "regex": "^[a-z0-9-]+$"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "politics",
        "economy",
        "youth",
        "society",
        "digital",
        "climate",
        "sport"
      ],
      "required": true
    },
    "authorName": {
      "type": "string"
    },
    "authorRole": {
      "type": "string"
    },
    "quote": {
      "type": "text"
    },
    "body": {
      "type": "blocks"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "legacyId": {
      "type": "integer",
      "unique": true
    }
  }
}