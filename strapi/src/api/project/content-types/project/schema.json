{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "مشروع",
    "description": "المشاريع والبطولات: صفحة المشاريع، وخيوط الأنشطة"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "key": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "text"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "project",
        "championship"
      ],
      "default": "project",
      "required": true
    },
    "listed": {
      "type": "boolean",
      "default": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "accent": {
      "type": "string",
      "regex": "^#[0-9A-Fa-f]{6}$"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "showAsThread": {
      "type": "boolean",
      "default": true
    },
    "activities": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::activity.activity",
      "mappedBy": "project"
    }
  }
}
